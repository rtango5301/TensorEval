# Site URL (used for OAuth redirect URLs in production)
NEXT_PUBLIC_SITE_URL=https://tensoreval.com

# Supabase Configuration
# Get these values from your Supabase project: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backend Workers (comma-separated, server-side only)
# Requests are load-balanced across these workers via /api/gateway
WORKER_URLS=https://worker-1.example.com,https://worker-2.example.com,https://worker-3.example.com

# Fallback single backend URL (used if WORKER_URLS is not set)
TENSOREVALS_BACKEND_URL=https://api.tensorevals.example.com

# HuggingFace proxy token (injected as Authorization header by the gateway)
TENSOREVALS_BACKEND_API_KEY=your-hf-token

# PostHog product analytics (login/auth telemetry)
# Project API key + host from https://posthog.com (US: https://us.i.posthog.com, EU: https://eu.i.posthog.com)
# Leave unset to disable telemetry entirely (app degrades gracefully).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-side salt used to hash emails before they are stored/sent (privacy-safe telemetry).
# Generate with: openssl rand -hex 32
AUTH_EVENT_HASH_SALT=

# Comma-separated Supabase user UUIDs allowed to access the /admin login-telemetry dashboard.
ADMIN_USER_IDS=

